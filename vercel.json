{
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), geolocation=(), microphone=()" }
      ]
    },
    {
      "source": "/cv/Abraham-Haddioui-Creative-Technologist.pdf",
      "headers": [
        { "key": "Content-Disposition", "value": "inline; filename=Abraham-Haddioui-Creative-Technologist.pdf" }
      ]
    }
  ]
}
